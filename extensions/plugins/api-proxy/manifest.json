{
  "api_version": 1,
  "id": "api-proxy",
  "name": "API Proxy",
  "version": "1.0.0",
  "author": "Oxide contributors",
  "license": "MIT OR Apache-2.0",
  "source": "https://github.com/yksaionara/oxide/tree/main/extensions/plugins/api-proxy",
  "kind": "plugin",
  "capabilities": [
    "api_proxy",
    "storage"
